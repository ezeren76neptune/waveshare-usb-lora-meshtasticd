     } else if (meshSolarInit()) {
         found = true;
 #ifdef HAS_ADS1115
@@ -2400,3 +2402,116 @@ bool Power::serialBatteryInit()
     return false;
 }
 #endif
+
+#if defined(ARCH_PORTDUINO) && defined(__linux__)
+#include <dirent.h>
+#include <fstream>
+
+/**
+ * Host battery, read from /sys/class/power_supply: a laptop running meshtasticd reports its own
+ * battery the way a handheld node reports its LiPo. Peripheral batteries (scope "Device", e.g. a
+ * wireless mouse) are skipped. A battery whose voltage can't be read is treated as absent, so the
+ * low-voltage shutdown never sees a bogus 0 mV.
+ */
+class LinuxBatteryLevel : public HasBatteryLevel
+{
+  public:
+    bool init()
+    {
+        battery = findSupply("Battery");
+        return !battery.empty();
+    }
+
+    int getBatteryPercent() override
+    {
+        long pct;
+        return readLong(battery + "/capacity", pct) ? clamp((int)pct, 0, 100) : -1;
+    }
+
+    uint16_t getBattVoltage() override
+    {
+        long uv;
+        if (!readLong(battery + "/voltage_now", uv) && !readLong(battery + "/voltage_min_design", uv))
+            return 0;
+        return (uint16_t)clamp(uv / 1000, 0L, 65535L);
+    }
+
+    bool isBatteryConnect() override
+    {
+        long present = 1; // not every driver has 'present'
+        readLong(battery + "/present", present);
+        return present && getBattVoltage() > 0;
+    }
+
+    bool isVbusIn() override
+    {
+        // Any mains/USB supply online, i.e. on the charger
+        bool online = false;
+        forEachSupply([&](const std::string &path) {
+            std::string type = readString(path + "/type");
+            long on;
+            if (type != "Battery" && readLong(path + "/online", on) && on)
+                online = true;
+        });
+        return online;
+    }
+
+    bool isCharging() override { return readString(battery + "/status") == "Charging"; }
+
+  private:
+    static constexpr const char *ROOT = "/sys/class/power_supply";
+    std::string battery;
+
+    template <typename F> static void forEachSupply(F f)
+    {
+        DIR *d = opendir(ROOT);
+        if (!d)
+            return;
+        while (dirent *e = readdir(d)) {
+            if (e->d_name[0] != '.')
+                f(std::string(ROOT) + "/" + e->d_name);
+        }
+        closedir(d);
+    }
+
+    static std::string findSupply(const char *wantType)
+    {
+        std::string found;
+        forEachSupply([&](const std::string &path) {
+            if (found.empty() && readString(path + "/type") == wantType && readString(path + "/scope") != "Device")
+                found = path;
+        });
+        return found;
+    }
+
+    static std::string readString(const std::string &path)
+    {
+        std::ifstream f(path);
+        std::string v;
+        std::getline(f, v);
+        return v;
+    }
+
+    static bool readLong(const std::string &path, long &out)
+    {
+        std::ifstream f(path);
+        return static_cast<bool>(f >> out);
+    }
+};
+
+static LinuxBatteryLevel linuxBatteryLevel;
+
+bool Power::linuxBatteryInit()
+{
+    if (!linuxBatteryLevel.init() || !linuxBatteryLevel.isBatteryConnect())
+        return false;
+    LOG_INFO("Power: using host battery from /sys/class/power_supply");
+    batteryLevel = &linuxBatteryLevel;
+    return true;
+}
+#else
+bool Power::linuxBatteryInit()
+{
+    return false;
+}
+#endif
