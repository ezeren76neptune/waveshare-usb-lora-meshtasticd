diff --git a/variants/native/portduino/platformio.ini b/variants/native/portduino/platformio.ini
index 0548138..5e1472b 100644
--- a/variants/native/portduino/platformio.ini
+++ b/variants/native/portduino/platformio.ini
@@ -546,3 +546,17 @@ build_src_filter =
   +<platform/portduino/PortduinoGlue.cpp> +<platform/portduino/SimRadio.cpp>
   +<platform/portduino/wasm/>
   +<modules/> -<modules/esp32/>
+
+; Waveshare USB-TO-LoRa (GD32F103 + SX1262) driven through its bridge firmware, which turns the
+; stick into a dumb SPI/GPIO adapter like a MeshStick's CH341. Same Ch341Hal; the libpinedio-usb
+; backend is swapped, as native-windows does. Use with `spidev: ch341`, USB_VID 0x1A86 / USB_PID 0x55D3.
+[env:native-wsbridge]
+extends = env:native
+build_flags = ${env:native.build_flags}
+  -I src/platform/portduino/wsbridge/include
+  -DMESHTASTIC_WSBRIDGE
+  ; No remote login shell: on a laptop the API port is reachable from whatever WiFi it is on
+  -DMESHTASTIC_EXCLUDE_DMSHELL
+lib_ignore =
+  ${portduino_base.lib_ignore}
+  Pine libch341-spi Userspace library
